{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@pidesk/shared": ["./packages/shared/src/index.ts"],
      "@pidesk/shared/*": ["./packages/shared/src/*.ts"],
      "@pidesk/pi-host": ["./packages/pi-host/src/index.ts"],
      "@pidesk/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
