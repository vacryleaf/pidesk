{
  "name": "@pidesk/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "predev": "pnpm --filter @pidesk/shared build && pnpm --filter @pidesk/pi-host build && pnpm --filter @pidesk/ui build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "build": {
    "appId": "eu.pidesk.app",
    "productName": "pidesk",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../../resources/pi",
        "to": "pi"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@pidesk/pi-host": "workspace:*",
    "@pidesk/shared": "workspace:*",
    "@pidesk/ui": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "5.0.0"
  }
}
